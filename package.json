{
  "name": "@georapbox/theme-toggle",
  "version": "2.0.0",
  "description": "A custom element for toggling between light and dark color themes while following the system preference by default.",
  "type": "module",
  "main": "dist/theme-toggle.js",
  "unpkg": "dist/theme-toggle.js",
  "types": "dist/theme-toggle.d.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/theme-toggle.d.ts",
      "import": "./dist/theme-toggle.js"
    },
    "./define": {
      "types": "./dist/theme-toggle.d.ts",
      "import": "./dist/theme-toggle-defined.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "files": [
    "/src",
    "/dist"
  ],
  "scripts": {
    "lint": "eslint",
    "format": "prettier --ignore-unknown --write .",
    "test": "web-test-runner",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage",
    "types": "tsc --project tsconfig.json",
    "dev:esbuild": "node ./scripts/dev.mjs",
    "dev": "npm-run-all clean dev:esbuild",
    "serve:dev": "web-dev-server --node-resolve --open /docs/ --watch",
    "start": "npm-run-all --parallel \"serve:dev -- {1}\" dev",
    "build:esbuild": "node ./scripts/build.mjs",
    "build": "npm-run-all clean build:esbuild",
    "analyze": "custom-elements-manifest analyze",
    "clean": "rimraf dist",
    "prepublishOnly": "npm-run-all clean lint test build types analyze"
  },
  "keywords": [
    "custom elements",
    "web components",
    "theme toggle",
    "dark mode",
    "light mode"
  ],
  "author": {
    "name": "George Raptis",
    "email": "georapbox@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georapbox/theme-toggle.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/georapbox/theme-toggle/issues"
  },
  "homepage": "https://github.com/georapbox/theme-toggle#readme",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "~0.11.0",
    "@eslint/js": "~10.0.1",
    "@esm-bundle/chai": "~4.3.4-fix.0",
    "@open-wc/testing": "~5.0.0",
    "@types/node": "~26.6.6",
    "@web/dev-server": "~1.0.0",
    "@web/test-runner": "~1.0.0",
    "@web/test-runner-playwright": "~1.0.0",
    "esbuild": "~0.28.2",
    "eslint": "~10.14.0",
    "eslint-plugin-wc": "~3.1.0",
    "globals": "~17.13.0",
    "npm-run-all": "~4.1.5",
    "playwright": "~1.64.1",
    "prettier": "~3.9.10",
    "rimraf": "~6.1.3",
    "sinon": "~22.1.0",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.17.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "rs-module-lexer@2.8.0": true
  }
}
